VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 本地脚本(scripts/)用 —— 只放在 .env 里,不要加 VITE_ 前缀(VITE_ 开头的会被打进浏览器 bundle)
SUPABASE_SECRET_KEY=
WEALTHSIMPLE_USER_ID=
# SnapTrade Personal API key(dashboard.snaptrade.com → API Key)。
# 本地同步脚本从这里读;线上投资组合页面用的是 Supabase Edge Function secrets 里的同名变量。
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
