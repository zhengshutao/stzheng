{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8888,
      "autoPort": false
    },
    {
      "name": "portfolio-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=8890 npm run dev"
      ],
      "port": 8890,
      "autoPort": false
    }
  ]
}
